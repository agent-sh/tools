{
  "name": "@agent-sh/harness-tools-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "AI agent harness tools for Bedrock Converse and OpenAI-compatible APIs",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-sh/tools.git"
  },
  "bugs": {
    "url": "https://github.com/agent-sh/tools/issues"
  },
  "homepage": "https://github.com/agent-sh/tools#readme",
  "author": "Avi Fenesh",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:harness": "node --test scripts/harness-final-answer.test.cjs",
    "typecheck": "turbo run typecheck",
    "test:dependencies": "node --test scripts/dependency-security.test.cjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "pnpm": {
    "overrides": {
      "read-yaml-file@1.1.0": "2.1.0",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "protobufjs@<=7.6.2": ">=7.6.3",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "js-yaml@<3.15.0": "^3.15.2",
      "js-yaml@>=4.0.0 <=4.1.1": "^4.2.0",
      "protobufjs@>=8.0.0 <8.6.6": ">=8.6.6",
      "undici@>=7.0.0 <7.29.1": ">=7.29.1 <8",
      "brace-expansion@>=4.0.0 <5.0.12": ">=5.0.12 <6",
      "ip-address@<=10.7.0": ">=10.7.1 <11",
      "basic-ftp@<=6.2.0": ">=6.2.1 <7",
      "minimatch@>=9.0.0 <11.0.1": ">=11.0.1 <12",
      "body-parser@>=2.3.0 <2.4.0": ">=2.4.0 <3",
      "qs@>=6.16.0 <6.16.1": ">=6.16.1 <7",
      "fast-uri@>=3.0.0 <3.1.9": ">=3.1.9 <4",
      "ip-address@>=10.2.0": ">=10.7.4 <11",
      "@earendil-works/pi-coding-agent>undici": ">=8.12.2 <9",
      "zod": ">=4.6.6 <5",
      "@hono/node-server@>=2.0.0 <2.1.6": ">=2.1.8",
      "hono@>=3.12.0 <4.13.16": ">=4.13.18"
    },
    "packageExtensions": {
      "typescript-language-server": {
        "dependencies": {
          "typescript": "^6.0.3"
        }
      }
    }
