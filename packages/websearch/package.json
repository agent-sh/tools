{
  "name": "@agent-sh/harness-websearch",
  "version": "0.8.1",
  "description": "WebSearch tool for AI agent harnesses: zero-config keyless web search (Exa/Parallel/Mojeek/Marginalia/Wikipedia fallback chain) with optional Brave/Tavily/SearXNG backends, SSRF defense, declarative query controls, result-count cap, and a discriminated result surface",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "tool-use",
    "websearch",
    "search",
    "searxng",
    "metasearch",
    "bedrock",
    "openai"
  ],
  "license": "MIT",
  "author": "Avi Fenesh",
  "homepage": "https://github.com/agent-sh/tools/tree/main/packages/websearch#readme",
  "bugs": {
    "url": "https://github.com/agent-sh/tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-sh/tools.git",
    "directory": "packages/websearch"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@agent-sh/harness-core": "workspace:*",
    "undici": "^7.30.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
